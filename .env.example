# Copie para .env e substitua todos os placeholders.
# Este arquivo não contém senha funcional. O .env local não entra no Git.

SECRET_KEY=altere_esta_chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,cge_web,cge_nginx

DB_NAME=cge
DB_USER=cge
DB_PASSWORD=altere_esta_senha
DB_HOST=cge_banco
DB_PORT=5432

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_HABILITADO=false
ANTHROPIC_HABILITADO=false
IA_INTEGRACAO=desligada
# Laboratório de classificação. Fica desligado até decisão explícita.
# Com true, só entra quem está no grupo CGE_LABORATORIO_PILOTO e já pode operar o processo.
LABORATORIO_HABILITADO=false
# Cache privado do PDF, em segundos. Zero obriga revalidação; não apaga bytes já gravados no navegador.
DOCUMENTO_CACHE_MAX_AGE=86400
IA_MAX_TENTATIVAS=2
IA_MAX_CARACTERES_CONTEXTO=12000

OPENAI_MODELO_PADRAO=
ANTHROPIC_MODELO_PADRAO=

DOMINIO=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Notebook: deixe os dois em false. No Linux, BEHIND_PROXY=true porque o Nginx
# é a única porta publicada. COOKIES_SEGUROS=true somente depois de HTTPS real.
COOKIES_SEGUROS=false
BEHIND_PROXY=false

REDIS_URL=redis://cge_redis:6379/0
NGINX_HTTP_PORT=8080

EMBEDDING_PROVEDOR=simulado
EMBEDDING_MODELO=simulado-deterministico
EMBEDDING_DIMENSAO=32
NORMATIVO_PESO_LEXICAL=0.45
NORMATIVO_PESO_VETORIAL=0.55

USUARIO_ADMIN=admin
USUARIO_ADMIN_SENHA=altere_esta_senha
USUARIO_AUDITOR=auditor
USUARIO_AUDITOR_SENHA=altere_esta_senha
USUARIO_ANALISTA=analista
USUARIO_ANALISTA_SENHA=altere_esta_senha

# Usuários de homologação (adm_cedro, aud_ipe, ana_araucaria).
# Não versionar a senha real. Troque antes de produção.
SENHA_HOMOLOGACAO=altere_esta_senha_homologacao

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
